generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] 
  output          = "../generated/prisma" // Mantén tu ruta de salida original
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // Mantenemos la extensión pgvector activa
}

model Products {
  id          Int                        @id @default(autoincrement())
  title       String
  price       Float
  description String
  embedding   Unsupported("vector(768)")? 
}